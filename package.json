{
  "name": "multi-conta-manager",
  "version": "1.8.1",
  "description": "Gerenciador de múltiplas contas/sessões em navegador (inspirado no Idle Labs) feito em Electron",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:css": "tailwindcss -i src-tailwind.css -o style.css --minify"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.exemplo.multicontamanager",
    "productName": "Multi Conta Manager",
    "icon": "build/icon.png",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "keywords": []
}

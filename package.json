{
  "name": "idle-hub",
  "version": "1.2.4",
  "description": "Idle Hub — gerenciador de múltiplas contas/sessões de navegador em workspaces, feito em Electron",
  "main": "main.js",
  "author": "Dinho",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "build:css": "tailwindcss -i src-tailwind.css -o style.css --minify"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "com.exemplo.idlehub",
    "productName": "Idle Hub",
    "icon": "build/icon.png",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "keywords": []
}
